    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Build per-URL Airtable filter formula.\n// All matches require expired != \"Yes\" (mirrors Job Board Masterlist Duplicate Checker view).\n// - example-jobboard.com: match by job ID (slug varies due to case / encoding / widget URLs)\n// - everything else: match on URL with query string stripped on both sides (handles utm/cid/gh_src/fbclid/lang/etc tracking params)\nconst item = $input.item.json;\nconst rawLink = (item.Link == null ? '' : String(item.Link)).trim();\nconst linkKey = rawLink.replace(/\\/+$/, '');\nconst rowNumber = item.row_number;\nlet uuid = item.uuid || item.UUID || item.Uuid || '';\nuuid = String(uuid).trim();\nif (!uuid) { uuid = 'missing-uuid-row-' + rowNumber; }\nconst isValid = rawLink.length > 0 && /^https?:\\/\\//i.test(rawLink);\nconst company = (item.Company || item.company || '').trim();\n\nlet _filterFormula;\nconst ca = linkKey.match(/culinaryagents\\.com\\/jobs\\/(\\d+)/i);\nif (ca) {\n  const jobId = ca[1];\n  _filterFormula = 'AND({expired} != \"Yes\", SEARCH(\"example-jobboard.com\", LOWER({appLink})) >= 1, SEARCH(\"/jobs/' + jobId + '-\", LOWER({appLink})) >= 1)';\n} else {\n  // Mirror Job Board Masterlist Duplicate Checker: case-insensitive substring search.\n  // A record matches if the input URL appears as a substring of the stored appLink.\n  // This handles widget/canonical URL pairs (input ⊆ stored) without creating\n  // false positives on URLs whose job ID is in the query string (mccarthy, etc).\n  const escaped = linkKey.replace(/\\\\/g, '\\\\\\\\').replace(/\"/g, '\\\\\"');\n  _filterFormula = 'AND({expired} != \"Yes\", SEARCH(LOWER(\"' + escaped + '\"), LOWER({appLink})) >= 1)';\n}\n\nreturn { json: { row_number: rowNumber, uuid, Link: rawLink, Company: company, _linkKey: linkKey, _isValid: isValid, _filterFormula } };"
      },
      "name": "Prepare Link1",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -960,
        528
      ],
      "id": "35baeb85-cb3d-520d-8223-a5165b1bb9de"
    },
    {
      "parameters": {
        "jsCode": "// Dedupe In Batch — spreads all row fields so Company is preserved\nconst seen = new Map();\nconst results = [];\nfor (const entry of $input.all()) {\n  const row = entry.json;\n  const key = (row._linkKey || '').toLowerCase();\n  if (!row._isValid) {\n    results.push({ json: { ...row, _batchDuplicate: false, _invalidLink: true } });\n    continue;\n  }\n  if (seen.has(key)) {\n    results.push({ json: { ...row, _batchDuplicate: true, _firstRow: seen.get(key) } });\n  } else {\n    seen.set(key, row.row_number);\n    results.push({ json: { ...row, _batchDuplicate: false } });\n  }\n}\nreturn results;"
      },
