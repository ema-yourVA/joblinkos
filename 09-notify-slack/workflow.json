{
  "name": "Job Link OS - Notify Slack (relay)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "<WEBHOOK_PATH>",
        "options": {}
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -600,
        0
      ],
      "notes": "POST { kind: \"links_collected\" | \"cleanup_done\" | \"cleanup_blocked\", …numbers }"
    },
    {
      "parameters": {
        "jsCode": "// Code body removed from the public copy (85 lines). The folder README says what it does."
      },
      "name": "Build Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -380,
        0
      ],
      "notes": "Unknown kind ⇒ no items ⇒ nothing is posted."
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "list",
          "value": "<SLACK_CHANNEL_ID>",
          "cachedResultName": "automation-alerts"
        },
        "text": "={{ $json.text }}",
        "otherOptions": {
          "includeLinkToWorkflow": false,
          "mrkdwn": true
        }
      },
      "name": "Post to #automation-alerts",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.4,
      "position": [
        -160,
        0
      ],
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Build Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Message": {
      "main": [
        [
          {
            "node": "Post to #automation-alerts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {}
}